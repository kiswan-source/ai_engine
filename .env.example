# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=AI Engine
APP_ENV=development          # development | production
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
DEBUG=true

# ─── Database ─────────────────────────────────────────────────────────────────
# SECURITY (Fase 0 / SEC-2): never leave these as the values shown here — they
# are recognized example values and startup will refuse to run in production
# if they're detected unchanged. Generate real ones, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_DB=ai_engine
POSTGRES_USER=aiuser
POSTGRES_PASSWORD=aipassword
DATABASE_URL=postgresql+asyncpg://aiuser:aipassword@localhost:5432/ai_engine

# ─── Redis / Queue ────────────────────────────────────────────────────────────
# REDIS_PASSWORD is required by docker-compose.yml (redis --requirepass) —
# generate a real value the same way as POSTGRES_PASSWORD above.
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379/0
RQ_QUEUE_AI=ai_queue
RQ_QUEUE_GIS=gis_queue
RQ_QUEUE_PIPELINE=pipeline_queue

# ─── Ollama / Gemma ───────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma3:27b          # or gemma3:12b for lighter
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

# ─── Cache ────────────────────────────────────────────────────────────────────
AI_CACHE_TTL=3600              # seconds — 1 hour
GIS_CACHE_TTL=86400            # seconds — 24 hours

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json                # json | text

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ─── Messaging & Memory (MASTER_INSTRUCTION.md Bab 22–23, Tahap 3) ───────────
# Broker fisik Message/Event Bus & Task Queue: memory (in-process, dev/CI) | redis (produksi)
MESSAGE_BROKER=redis
# Tier memori volatile (working/summary/reflection): memory | redis
MEMORY_BACKEND=redis
# Tier memori persisten (conversation/long-term): memory | postgres
MEMORY_PERSISTENT_BACKEND=postgres
WORKING_MEMORY_TTL=3600        # seconds
# Pelacakan state task/workflow (Bab 49): memory | redis (tahan restart)
TASK_STATE_BACKEND=redis
TASK_STATE_TTL=86400           # seconds

# ─── Reflection / Consensus / Confidence / Human Approval (Bab 25-28, 57, 61) ─
REFLECTION_MAX_ITERATIONS=3
CONFIDENCE_THRESHOLD_DEFAULT=0.6
CONFIDENCE_THRESHOLD_HIGH_RISK=0.85
CONSENSUS_DEBATE_ROUNDS=1
ENABLE_CONSENSUS_VOTING=true
ENABLE_HUMAN_APPROVAL=true
APPROVAL_SLA_SECONDS=3600       # seconds
APPROVAL_STATE_BACKEND=redis    # memory (dev/CI) | redis (production, multi-replica)

# ─── Provider Layer (MASTER_INSTRUCTION.md Bab 16) ────────────────────────────
# Leave a key blank to keep that provider DISABLED; the Model Registry (Bab 20)
# then falls back to local Ollama automatically. Never commit real keys (Bab 45.4).
PROVIDER_TIMEOUT=120

# ─── Circuit Breaker (MASTER_INSTRUCTION.md Bab 55, Tahap 9) ─────────────────
ENABLE_CIRCUIT_BREAKER=true
CIRCUIT_FAILURE_THRESHOLD=5     # kegagalan beruntun sebelum Open
CIRCUIT_RECOVERY_TIMEOUT=30     # detik Open sebelum Half-Open
CIRCUIT_TRIAL_REQUESTS=1        # jumlah probe saat Half-Open
# Tuning per provider (aturan Bab 55 — jangan disamaratakan):
# format "provider:threshold/recovery_detik/trials", contoh "openai:3/60/1,gemini:5/30/2"
CIRCUIT_PROVIDER_OVERRIDES=
CIRCUIT_STATE_BACKEND=redis     # memory (dev/CI) | redis (shared antar-replika)

# OpenAI (ChatGPT) — orchestration, planning, review, QA
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# Anthropic (Claude) — analysis, writing, coding, critique
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
CLAUDE_MODEL=claude-sonnet-5

# Google (Gemini) — research, vision, documents
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-pro-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# ─── RAG (MASTER_INSTRUCTION.md Bab 29) ───────────────────────────────────────
RAG_EMBEDDING_PROVIDER=openai  # openai | gemini | ollama | hashed
RAG_EMBEDDING_DIM=1536         # must match the provider's embedding output width
VECTOR_BACKEND=pgvector        # memory (dev/CI) | pgvector (production)
RAG_CHUNK_SIZE=800             # characters
RAG_CHUNK_OVERLAP=100          # characters
RAG_TOP_K=5
RAG_HYBRID_ALPHA=0.5           # 1.0 = pure semantic, 0.0 = pure keyword
RAG_RERANK_ENABLED=true
RAG_MAX_CONTEXT_CHARS=4000

# ─── Telemetry (MASTER_INSTRUCTION.md Bab 27, 33-35, 56) ──────────────────────
TRACE_BACKEND=redis            # memory (dev/CI) | redis (production)
COST_BACKEND=redis
TRACE_MAX_SPANS_PER_TRACE=200
METRICS_MAX_SAMPLES=2000
COST_BUDGET_PER_TASK=5.0        # USD; exceeding escalates to Human Approval
COST_BUDGET_DAILY=50.0          # USD; exceeding surfaces as an alert
ALERT_ERROR_RATE_THRESHOLD=0.2
ALERT_LATENCY_P95_MS=30000

# ─── Security (MASTER_INSTRUCTION.md Bab 30, 31, 58) ──────────────────────────
ENABLE_PROMPT_GUARD=true
PROMPT_GUARD_SUSPICIOUS_THRESHOLD=0.4
PROMPT_GUARD_BLOCK_THRESHOLD=0.8
ENABLE_PII_REDACTION=true
ENABLE_OUTPUT_VALIDATION=true
AUDIT_LOG_PATH=security_audit.log
API_KEYS=                       # comma-separated; blank disables auth.py's dependency
