# Multi-stage build (Bab 37 rule 2, ADR-0009 follow-up) — the single-stage
# version kept gcc/libpq-dev/libgdal-dev (compiler + dev headers, needed only
# to build wheels for asyncpg/psycopg2/fiona/shapely/pyproj) in the final
# runtime image. Verified live (not just reviewed) that dropping them from
# the runtime stage doesn't break GIS: fiona/shapely/pyproj ship manylinux
# wheels that bundle their own GDAL/GEOS/PROJ shared libraries (auditwheel),
# so nothing in `agent/tools/gis_io.py`/`core/gis/processor.py` needs the
# system libgdal at runtime — only pip needed it, at build time, to resolve
# wheels for this platform.

FROM python:3.12-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    gdal-bin \
    libgdal-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir -r requirements.txt


FROM python:3.12-slim

# curl + libexpat1 — no compiler, no dev headers, no GDAL toolchain in the
# shipped image. libexpat1 (GDAL's XML parser, used for KML/GML) is NOT
# bundled inside fiona's manylinux wheel the way libgdal/libgeos/libproj
# are — verified live: fiona import failed with
# "ImportError: libexpat.so.1: cannot open shared object file" the first
# time this stage dropped libgdal-dev (which used to pull it in
# transitively via apt, masking the real dependency).
#
# tesseract-ocr + tesseract-ocr-ind — agent/tools/readers.py::read_image()
# calls pytesseract.image_to_string(img, lang="eng+ind"). pytesseract is a
# pure-Python wrapper around the `tesseract` CLI binary (already in
# requirements.txt, but the binary itself was never installed here, so OCR
# failed silently/errored at runtime, never caught because no test exercises
# a real Tesseract binary). tesseract-ocr's default Debian package only
# ships English trained data — tesseract-ocr-ind is the separate package for
# the Indonesian half of "eng+ind", required since this is an Indonesian
# mining-document tool.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libexpat1 \
    tesseract-ocr \
    tesseract-ocr-ind \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY . .

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# /health/ (not /health/ready) — deliberately the cheap liveness check, not
# the deep readiness one. /health/ready calls check_readiness(), which makes
# real network calls to Ollama + every configured cloud provider — Tahap 26
# measured that at 9-32s live. Polling that every 30s as a container
# healthcheck would mark the API "unhealthy" (and get restarted by an
# orchestrator) on nothing more than Ollama being briefly slow.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health/ || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
